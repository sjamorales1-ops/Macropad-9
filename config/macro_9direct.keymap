#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        Lock: Lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(L)>;
            label = "LOCK";
        };

        Back: Back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(ENTER)>;
            label = "BACK";
        };

        close: close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(F4)>;
            label = "CLOSE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp PAGE_UP   &kp C_PLAY_PAUSE  &kp PAGE_DOWN
&kp C_VOL_DN  &lt 2 UP_ARROW    &kp C_VOLUME_UP
&kp LEFT      &lt 1 DOWN        &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&bootloader   &sys_reset    &studio_unlock
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2
&bt BT_SEL 3  &trans        &bt BT_CLR_ALL
            >;
        };

        layer_2 {
            bindings = <
&close  &Back   &Lock
&trans  &trans  &trans
&trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans
&trans  &trans  &trans
&trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans
&trans  &trans  &trans
&trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans
&trans  &trans  &trans
&trans  &trans  &trans
            >;
        };
    };
};
